																								<script type="text/javascript">
							var StoreDefaults = {"PartnerEventStore":[{"gid":"675119576448500282","clan_steamid":"103582791473247951","event_name":"OUT NOW: HEAVY DUTY EXPANSION","event_type":14,"appid":2321470,"server_address":"","server_password":"","rtime32_start_time":1777547760,"rtime32_end_time":1777552201,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"75f45032bcf273f1f4dbd505cccd61d40bca546e.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"c549790a7975e31653bce8210fee68ffb064266b.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[],\"library_spotlight\":true}","announcement_body":{"gid":"675119576448500283","clanid":"43726543","posterid":"0","headline":"OUT NOW: HEAVY DUTY EXPANSION","posttime":1777546869,"updatetime":1777559304,"body":"[p][\/p][previewyoutube=\"h5JKcMD7-QE;full\"][\/previewyoutube][h1]Hello Miners,\u00a0[\/h1][p]It\u2019s time to gear up. Today we\u2019re launching [b]Heavy Duty[\/b], a brand-new paid DLC packed with destructive firepower, frozen frontiers, and high-stakes missions. Alongside it, a [b]free update[\/b] rolls out to all players with endless mode, mastery rewards, tag system changes, and the usual slew of system improvements, bug fixes, and balance changes.[\/p][p]Let\u2019s break it down:[\/p][p][dynamiclink href=\"https:\/\/store.steampowered.com\/app\/4395500\/Deep_Rock_Galactic_Survivor__Heavy_Duty_Expansion\/\"][\/dynamiclink][\/p][hr][\/hr][p][\/p][h1][b]HEAVY DUTY EXPANSION (DLC):[\/b][\/h1][p][\/p][h2][b]NEW CLASS: THE DEMOLISHER[\/b][\/h2][p][b]Built for destruction. Engineered for overkill.[\/b][\/p][p]For the first time in DRG history, we\u2019re introducing a new class: The Demolisher.[\/p][p]This new powerhouse class operates a fully weaponized industrial vehicle known as the Rockdozer, turning the battlefield into a demolition site. Crush the swarms beneath your wheels, leaving a trail of devastation. If the other dwarves fight the bugs\u2026the Demolisher plows them down.[\/p][p]The Demolisher brings an arsenal of 11 new weapons with him to Hoxxes, available to other classes via the tag system[\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/43726543\/db93b2e83a7e8697813bac7fc2b25ba2a978ec1f.gif\"][\/img][\/p][hr][\/hr][h2][b]\nNEW MISSION: EGG HUNT[\/b][\/h2][p]Collect alien eggs and have Bosco deliver them to a central cargo pod in a star-shaped flow, forcing you to branch out and return under fire. Once you hit the quota, a short grace period lets you risk it all for extra rewards\u2026 if you dare.[\/p][p]Deliver the final egg, and everything changes. A Brood Nexus erupts on top of the pod, locking down your exit and triggering a multi-phase boss fight. It spawns relentless waves of enemies, and at key moments, creates Nexus Sprouts that must be destroyed before you can damage the nexus again.[\/p][p][\/p][hr][\/hr][p][\/p][h2][b]NEW BIOME: GLACIAL STRATA[\/b][\/h2][p]Glacial Strata introduces a fast-paced frozen biome where the environment is as powerful as your arsenal. Slide across smooth ice for bursts of speed at the cost of control, trigger deadly icicle traps by shattering ice crystals, and face new cryo-infused enemies adapted to the cold.\u00a0[\/p][p]With more biome choices added to missions, and without increasing progression requirements, you gain greater freedom to tackle challenges your way.[\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/43726543\/99a7d1773a4e4f5cb096405455a83cfa2aeec55e.gif\"][\/img][\/p][hr][\/hr][p][\/p][h1][b]Update 1.1 (Free Content)[\/b][\/h1][h2][b]Endless Mode[\/b][\/h2][p]The long-awaited Endless Mode is finally here.[\/p][p]The first 10 stages of an Endless Dive are shorter, with increased enemy density. You will move through these early stages quickly while ramping up your power at a much faster pace than usual.[\/p][p]Endless is a variant of Elimination, but with its own constraints. You can only carry up to 15 artifacts, so every choice matters. From stage 11 onward, the challenge shifts. Difficulty increases significantly, and each stage will test your build and decision-making skills.[\/p][p]We have spent months optimizing Survivor, but we fully expect players to find new and creative ways to push systems to their limits. We are looking forward to seeing what you come up with.[\/p][p][\/p][hr][\/hr][p][\/p][h2][b]Mastery Rewards[\/b][\/h2][p]For those who take on the toughest hazards, mastery now comes with additional rewards.[\/p][p]Mastery milestones grant rewards based on mastery points earned. Higher hazard levels yield more points, meaning greater rewards for players who push themselves further.[\/p][p]This system is aimed at the greybeards who want their skill and persistence to be recognized.[\/p][p][\/p][hr][\/hr][p][\/p][h2][b]Tag System Expansion[\/b][\/h2][p]With the new weapons and effects added to the pool from the DLC, we wanted to expand the available synergies and give all players more options and variation in their builds. That\u2019s why we\u2019ve added new tags and tag synergies.[\/p][p]We have added new overclocks to match the tags, so if you pick a Sidearm overclock, you can also get an Ultimate Sidearm Unstable overclock. If you pick the sidearm overclock on multiple weapons, you can start getting upgrade cards to match that synergy.[\/p][p]Some tags already existed, like Spray and Precise, but were never used, so now you can pick upgrade cards for those as well!\u00a0[\/p][p][b]The new tags and tag synergy upgrade cards are:[\/b][\/p][p]Sidearm, Favourite, Groundzone, Thick Boy, Spray, and Precise[\/p][p][\/p][hr][\/hr][p][\/p][h2][b]Improvements & Fixes\u00a0[\/b][\/h2][list][*][p]Picking overclocks now adds relevant \\[tag][\/p][\/*][*][p]Upgraded to Unity 6[\/p][\/*][*][p]KD-tree-based physics improvements[\/p][\/*][*][p]XP cube performance optimizations[\/p][\/*][*][p]VFX system improvements[\/p][\/*][*][p]Memory leak fixes and general stability improvements[\/p][\/*][*][p]Achievement \u201cUnreasonable uptime\u201d: Fixed an issue where the achievement still required 60 seconds, even though it should be 30 seconds. (again)[\/p][\/*][*][p]Achievement \u201cUndercooked\u201d: Fixed an issue where you didn\u2019t get the achievement if you salvaged the Overclock. (again)[\/p][\/*][*][p]Mission Goals: Fixed an issue where you had to complete 2 stages instead of just 1 while activating B0b-33 no more than 2 times. Also, B0b-33 now only activates if there is fuel. (again)[\/p][\/*][*][p]Improved the design of achievements where you have to equip 6 pieces of gear of the same rarity. It now also counts higher rarity gear. (\u2026\u2026again)[\/p][\/*][\/list][h2][b]Balance changes[\/b][\/h2][list][*][p]Overclock balance[\/p][list][*][p]NEW UOC: Ultimate sidearm: +60% damage to all other weapons[\/p][\/*][\/list][\/*][*][p]Weapon balance[\/p][list][*][p]\"Lead Storm\" Powered Minigun buffed: Clip size 150 \u2192 200, base damage 25 \u2192 28[\/p][\/*][*][p]Voltaic Stun Sweeper buffed (again): Base damage 48 \u2192 55, Potency 20 \u2192 22[\/p][\/*][*][p]Breach Cutter (again): Has the \\[Lasting] tag[\/p][\/*][\/list][\/*][*][p]Artifacts balance[\/p][list][*][p]Multi Tool nerfed: Reload speed -25% \u2192 -20%, every unique \\[Tag] equipped: reload speed +5% \u2192 +4%[\/p][\/*][\/list][\/*][*][p]Elimination gate 2 nerfed (again): Mandatory Pep Talk now gives +10% XP gain, and +100 Max HP, Omega Mini Exploders mutator is changed to Serrated Claws II[\/p][\/*][\/list][p]That\u2019s everything for today\u2019s launch. Whether you\u2019re crushing bugs with the Demolisher or pushing your limits in Endless Mode, there\u2019s a lot to dig into.[\/p][p]Now get back down there, miner.[\/p][p][b]Rock and Stone.[\/b][\/p]","commentcount":179,"tags":["mod_reviewed","ModAct_1434411615_1777547428_0","ModAct_1894963720_1777559423_4"],"language":0,"hidden":0,"forum_topic_id":"842878662568155432","event_gid":"675119576448500282","voteupcount":1469,"votedowncount":126,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"842878662568155432","rtime32_last_modified":1777793637,"news_post_gid":"0","rtime_mod_reviewed":1777559423,"featured_app_tagid":0,"referenced_appids":[],"build_id":23025635,"build_branch":"","unlisted":0,"rtime_created":1777540910,"votes_up":1469,"votes_down":126,"comment_type":"ForumTopic","gidfeature":"3792632220364947501","gidfeature2":"842878662568155432"},{"gid":"506233956051452739","clan_steamid":"103582791473247951","event_name":"Coming Soon: Endless Mode","event_type":28,"appid":2321470,"server_address":"","server_password":"","rtime32_start_time":1777025100,"rtime32_end_time":1777028460,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[\"75f45032bcf273f1f4dbd505cccd61d40bca546e.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[\"a72e91cc6964be915649eec80a39b56b4f8f21a2.png\",null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"506233956051452740","clanid":"43726543","posterid":"0","headline":"Coming Soon: Endless Mode","posttime":1777025106,"updatetime":1777562346,"body":"[p]Alongside the upcoming paid expansion [i]Heavy Duty[\/i], we are releasing a free game update packed with new systems, improvements, and ways to push your builds further than before. Here is a look at what is coming on April 30th.[\/p][p][\/p][h3][b]Endless Mode[\/b][\/h3][p]The long-awaited Endless Mode is finally here.[\/p][p]The first 10 stages of an Endless Dive are shorter, with increased enemy density. You will move through these early stages quickly while ramping up your power at a much faster pace than usual.[\/p][p]Endless is a variant of Elimination, but with its own constraints. You can only carry up to 15 artifacts, so every choice matters. From stage 11 onward, the challenge shifts. Difficulty increases significantly, and each stage will test your build and decision-making skills.[\/p][p]We have spent months optimizing Survivor, but we fully expect players to find new and creative ways to push systems to their limits. We are looking forward to seeing what you come up with.[\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/43726543\/0c1d67cb3379f68941b40a7e7cc983d50c5c5daf.png\"][\/img][\/p][hr][\/hr][p][\/p][h3][b]Mastery Milestones[\/b][\/h3][p]For those who take on the toughest hazards, mastery now comes with additional rewards.[\/p][p]Mastery milestones grant rewards based on mastery points earned. Higher hazard levels yield more points, meaning greater rewards for players who push themselves further.[\/p][p]This system is aimed at the greybeards who want their skill and persistence to be recognized.[\/p][p][\/p][hr][\/hr][p][\/p][h3][b]Tag System Expansion[\/b][\/h3][p]With the upcoming new weapons and effects added to the pool from the DLC, we wanted to expand the available synergies and give all players more options and variation in their builds. That\u2019s why we\u2019ve added some new tags like [b]\\[Ground Zone][\/b], so you can make a build that specializes in damage done with area-of-effect weapons that leave ground zone damaging effects. [\/p][p][img src=\"{STEAM_CLAN_IMAGE}\/43726543\/e4b7e502afd4d58234a36f3bb83ff6777fa8703b.png\"][\/img][\/p][p]We have also added new overclocks to match the tags, so if you pick a Sidearm overclock you can also get an Ultimate Sidearm Unbalance overclock. If you pick the sidearm overclock on multiple weapons, you can start getting upgrade cards to match that synergy.[\/p][p][\/p][p]Some tags already existed, like Spray and Precise, but were never used, so now you can pick upgrade cards for those as well!\u00a0[\/p][p]For a full list of tag additions and changes, check out the patch notes on launch day.[\/p][p][\/p][hr][\/hr][p][\/p][h3][b]Optimizations & Improvements[\/b][\/h3][p]This update includes major technical upgrades:[\/p][list][*][p]Upgrade to Unity 6[\/p][\/*][*][p]KD-tree based physics improvements[\/p][\/*][*][p]XP cube performance optimizations[\/p][\/*][*][p]VFX system improvements[\/p][\/*][*][p]Memory leak fixes and general stability improvements[\/p][\/*][\/list][p][\/p][hr][\/hr][p][\/p][p]This free update arrives alongside the [i]Heavy Duty[\/i] expansion on April 30th. Not long to go now! If you haven\u2019t already, make sure to wishlist Heavy Duty so you get notified when it releases.[\/p][p][\/p][p][dynamiclink href=\"https:\/\/store.steampowered.com\/app\/4395500\/Deep_Rock_Galactic_Survivor__Heavy_Duty_Expansion\/\"][\/dynamiclink][\/p][p]\u00a0[\/p][p][b]Rock and Stone[\/b][\/p][p]\n[\/p]","commentcount":76,"tags":["mod_reviewed","ModAct_1889357040_1777026250_0","ModAct_1691520782_1777564300_4"],"language":0,"hidden":0,"forum_topic_id":"802345853100494295","event_gid":"506233956051452739","voteupcount":1268,"votedowncount":20,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":1777025100,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"802345853100494295","rtime32_last_modified":1777787597,"news_post_gid":"0","rtime_mod_reviewed":1777564301,"featured_app_tagid":0,"referenced_appids":[],"build_id":0,"build_branch":"","unlisted":0,"rtime_created":1777024209,"votes_up":1268,"votes_down":20,"comment_type":"ForumTopic","gidfeature":"3792632220364947501","gidfeature2":"802345853100494295"},{"gid":"675119576448500444","clan_steamid":"103582791473247951","event_name":"1.1 Hotfix 1","event_type":12,"appid":2321470,"server_address":"","server_password":"","rtime32_start_time":1777632660,"rtime32_end_time":1777636801,"comment_count":0,"creator_steamid":"0","last_update_steamid":"0","event_notes":"see announcement body","jsondata":"{\"localized_subtitle\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_summary\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_title_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_capsule_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"bSaleEnabled\":false,\"sale_show_creator\":false,\"sale_sections\":[],\"sale_browsemore_text\":\"\",\"sale_browsemore_url\":\"\",\"sale_browsemore_color\":\"\",\"sale_browsemore_bgcolor\":\"\",\"localized_sale_header\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_overlay\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_product_mobile_banner\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_sale_logo\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"sale_font\":\"\",\"sale_background_color\":\"\",\"sale_header_offset\":530,\"referenced_appids\":[],\"bBroadcastEnabled\":false,\"broadcastChatSetting\":\"hide\",\"default_broadcast_title\":\"#Broadcast_default_title_dev\",\"localized_broadcast_title\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_left_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"localized_broadcast_right_image\":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],\"broadcast_whitelist\":[],\"bScheduleEnabled\":false,\"scheduleEntries\":[]}","announcement_body":{"gid":"675119576448500445","clanid":"43726543","posterid":"0","headline":"1.1 Hotfix 1","posttime":1777632681,"updatetime":1777632681,"body":"[h2]Improvements & Fixes[\/h2][list][*][p]Deepcore PGL: Cluster grenade performance issues fixed[\/p][\/*][*][p]Improved Demolisher drop pod ramp gameplay[\/p][\/*][*][p]Fixed a milestone pop up issue[\/p][\/*][*][p]Doubled the chance of honk and stone[\/p][\/*][\/list][h2]Balance changes[\/h2][list][*][p]Demolisher handling buffed: Increased turning speed[\/p][\/*][*][p]Demolisher Contractor buffed:[\/p][list][*][p]Move speed: Moved from class mod to class[\/p][\/*][*][p]Armor: +10% \u2192 +20%[\/p][\/*][*][p]Base HP: 150 \u2192 175[\/p][\/*][*][p]Max HP: +10%[\/p][\/*][\/list][\/*][*][p]Demolisher Gridrunner buffed:[\/p][list][*][p]Move speed: moved from Class mod to class[\/p][\/*][*][p]Armor: +10% \u2192 +15%[\/p][\/*][*][p]Pickup Radius: +20% \u2192 +30%[\/p][\/*][*][p]Base HP: 150 \u2192 175[\/p][\/*][*][p]Life Regen: +5[\/p][\/*][*][p]Potency: +10% \u2192 +20%[\/p][\/*][\/list][\/*][*][p]Demolisher Operator buffed:[\/p][list][*][p]Move speed: moved from Class mod to class[\/p][\/*][*][p]Armor: +10% \u2192 +20%[\/p][\/*][*][p]Base HP: 150 \u2192 175[\/p][\/*][*][p]Life Regen: +5[\/p][\/*][\/list][\/*][*][p]Dragonstorm Incinerator buffed: Groundzone damage buffed 50%[\/p][\/*][*][p]Slither Drones buffed: Base damage 50 \u2192 65[\/p][\/*][*][p]Carrier Drone buffed: Base damage 18 \u2192 22[\/p][\/*][*][p]Chimera Fragcannon buffed: Clip size 8 \u2192 10, base damage 140 \u2192 160[\/p][\/*][*][p]Twincoil Archbuster buffed: Reload speed 3 sec \u2192 2 sec[\/p][\/*][\/list]","commentcount":47,"tags":["patchnotes","mod_reviewed","ModAct_1434278705_1777637065_0"],"language":0,"hidden":0,"forum_topic_id":"842878859177124512","event_gid":"675119576448500444","voteupcount":601,"votedowncount":11,"ban_check_result":0,"banned":0},"published":1,"hidden":0,"rtime32_visibility_start":0,"rtime32_visibility_end":0,"broadcaster_accountid":0,"follower_count":0,"ignore_count":0,"forum_topic_id":"842878859177124512","rtime32_last_modified":1777789303,"news_post_gid":"0","rtime_mod_reviewed":1777637066,"featured_app_tagid":0,"referenced_appids":[],"build_id":23044391,"build_branch":"","unlisted":0,"rtime_created":1777628525,"votes_up":601,"votes_down":11,"comment_type":"ForumTopic","gidfeature":"3792632220364947501","gidfeature2":"842878859177124512"}],"EventWebRowEmbed":{"bPreLoaded":true,"announcementGIDList":["675119576448500283","506233956051452740"],"last_update_event":{"rtime":1777632660,"event_gid":"675119576448500444","announcement_gid":"675119576448500445","clan_account_id":43726543}}};
